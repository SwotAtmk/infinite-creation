# 复制为 .env 后再修改：cp .env.docker.example .env
#
# ============================================================
# 模式一：PostgreSQL（默认，推荐正式部署）
# ============================================================
DB_MODE=postgres
COMPOSE_PROFILES=postgres
POSTGRES_DB=infinite_creation
POSTGRES_USER=ic
POSTGRES_PASSWORD=change-me-please

# ============================================================
# 模式二：SQLite（单机 / 试用）
# 把上面三行改成下面这样（COMPOSE_PROFILES 必须为空，db 不会启动）：
# ============================================================
# DB_MODE=sqlite
# COMPOSE_PROFILES=
# POSTGRES_PASSWORD=

# 对外访问端口（Web 入口）
WEB_PORT=4710

# Web 入口：studio = Studio 页面（默认）；classic = 经典 Next 页面
# 只启动一个 web 进程，不会同时跑两套页面。
WEB_MODE=studio
TZ=Asia/Shanghai

# 可选：完全自定义 PostgreSQL 连接串（默认由上面的 POSTGRES_* 拼出来）
# DATABASE_URL=postgres://ic:密码@db:5432/infinite_creation
